# Neon Postgres connection string — get from Neon dashboard > Connection Details.
# This is the pooled (PgBouncer, "-pooler") endpoint. That's fine to use as-is;
# app/db.py disables psycopg3's auto-prepared statements (prepare_threshold=None)
# to stay compatible with PgBouncer's transaction-pooling mode.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=https://kaara.ai,http://localhost:3000
